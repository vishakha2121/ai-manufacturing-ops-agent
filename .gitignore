# ----------------------------
# Machine Learning Models
# ----------------------------
# Don't commit trained models (they're big & reproducible)
backend/ml_models/saved_models/*.pkl
backend/ml_models/saved_models/*.joblib
backend/ml_models/saved_models/*.h5
backend/ml_models/saved_models/*.keras
backend/ml_models/saved_models/*.pt
backend/ml_models/saved_models/*.pth
backend/ml_models/saved_models/*.onnx
backend/ml_models/saved_models/*.bin
backend/ml_models/saved_models/*.sav

# But DO keep the folder
!backend/ml_models/saved_models/.gitkeep

# TensorFlow / PyTorch checkpoints
*.ckpt
*.ckpt.*
checkpoints/
runs/
logs/

# ----------------------------
# Node / Frontend
# ----------------------------
node_modules/
node_modules
.npm
.npmrc
.yarn
.yarnrc
.pnp
.pnp.js

# Build outputs
frontend/dist/
frontend/build/
frontend/.vite/
dist/
build/

